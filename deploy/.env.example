# Copy to .env (never commit it). Make each secret with: openssl rand -base64 48
FUTSLOT_DOMAIN=futslot.dahalutsab.com.np

DB_PASSWORD=
JWT_SECRET=
OTP_SECRET=
SITES_SESSION_SECRET=

# No SMS provider yet: show sign-in codes on screen instead
SHOW_SIGN_IN_CODES=true

# Venues' pages in search results. Off while the venues are made-up demo ones (only FutSlot's front page is then
# for search engines); true once real venues join and the demo ones are gone
SEARCH_INDEXING=false

# Where players send deposit top-ups. On a demo, say not to.
FUTSLOT_PAYMENT_INSTRUCTIONS=This is a demo: don't send real money. Enter any transaction ID, like DEMO-123, and an admin approves it.
FUTSLOT_PAYMENT_INSTRUCTIONS_NE=यो डेमो हो: साँच्चैको पैसा नपठाउनुहोस्। DEMO-123 जस्तो कुनै पनि ट्रान्ज्याक्सन आइडी लेख्नुहोस्, एडमिनले स्वीकृत गर्छ।

# Demo data (seed-demo.sh): the password for the accounts it makes
DEMO_PASSWORD=
